# Variables de Entorno para We Player Landing / Antigravity E-commerce
# Copia este archivo a .env.local y completa con tus valores reales

# ============================================
# Configuración del Sitio Web
# ============================================
# DESARROLLO LOCAL: URL local
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PRODUCCIÓN: URL de producción (comentada para desarrollo)
# NEXT_PUBLIC_BASE_URL=https://wetechlatam.com

# ============================================
# Resend API Key
# ============================================
# Obtén tu API key desde: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email destinatario para recibir los mensajes del formulario de contacto
EMAIL_DESTINATARIO=tu-email@ejemplo.com

# ============================================
# Configuración de Base de Datos (PostgreSQL)
# ============================================
# DESARROLLO LOCAL: Base de datos Docker
# Para iniciar: docker-compose up -d
# Nota: sslmode=disable para desarrollo local (Docker no requiere SSL)
# Formato: postgresql://usuario:password@localhost:5432/database?sslmode=disable
DATABASE_URL=postgresql://wetechar:wetechar@localhost:5432/shop_dev?sslmode=disable

# PRODUCCIÓN: Base de datos PostgreSQL de Vercel/Prisma (comentadas para desarrollo)
# DATABASE_URL=postgres://usuario:password@host:puerto/database?sslmode=require
# POSTGRES_URL=postgres://usuario:password@host:puerto/database?sslmode=require

# Prisma Accelerate (Opcional - para mejor rendimiento en producción)
# Obtén tu API key desde: https://console.prisma.io/
# PRISMA_DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=tu-api-key

# ============================================
# Configuración de Auth0
# ============================================
# Obtén estos valores desde: https://manage.auth0.com/dashboard
AUTH0_SECRET=tu-secret-key-generado-aleatoriamente-minimo-32-caracteres
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://tu-tenant.auth0.com
AUTH0_CLIENT_ID=tu-client-id
AUTH0_CLIENT_SECRET=tu-client-secret

# ============================================
# Configuración de Webhook de Auth0 (Opcional)
# ============================================
# Para sincronizar usuarios automáticamente al registrarse
AUTH0_WEBHOOK_SECRET=tu-webhook-secret
